# ================= Godot 4 =================
# Generated editor data (import cache, UID cache, extension list, logs).
# NEVER commit this - it regenerates on import.
.godot/

# Legacy Godot 3 import directory (harmless if absent).
.import/

# NOTE: per-asset *.import files (icon.png.import, *.glb.import, ...) ARE
# tracked on purpose - they hold import settings (scale, materials, LODs).

# Export system: local preset output and export templates config.
export.cfg
export_presets.cfg
builds/
exports/
*.apk
*.aab
*.pck
*.zip

# FuncGodot / TrenchBroom working files.
maps_quake/autosave/
*.tbautosave

# ============== GDExtension binaries ==============
# Compiled output - rebuild via cargo / scons, don't commit.
rust/bin/
cpp/bin/
*.dll
*.so
*.dylib

# ============== Rust (cargo) ==============
rust/target/
**/*.rs.bk
Cargo.lock
rust/.cargo/

