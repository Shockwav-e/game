[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.2"

[libraries]
windows.debug.x86_64 = "res://rust/bin/wandstrike_rust.windows.debug.x86_64.dll"
windows.release.x86_64 = "res://rust/bin/wandstrike_rust.windows.release.x86_64.dll"
linux.debug.x86_64 = "res://rust/bin/libwandstrike_rust.linux.debug.x86_64.so"
linux.release.x86_64 = "res://rust/bin/libwandstrike_rust.linux.release.x86_64.so"
